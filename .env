# Research Agent 环境变量配置
# 请根据实际情况修改以下配置

# OpenAI API 配置
OPENAI_API_KEY=REDACTED_OPENAI_API_KEY

# 邮件配置
EMAIL_SENDER=noreply@zhatgpt.com
EMAIL_RECEIVER=REDACTED_EMAIL
EMAIL_SENDER_NAME=Research Agent

# Mailgun API 配置
USE_MAILGUN_API=true
MAILGUN_API_KEY=REDACTED_MAILGUN_API_KEY
MAILGUN_DOMAIN=zhatgpt.com

# SMTP服务器配置（备用，如果Mailgun API失败时使用）
SMTP_SERVER=localhost
SMTP_PORT=25
SMTP_USE_SSL=false
SMTP_USE_TLS=false
EMAIL_PASSWORD=

# Flask 配置
FLASK_DEBUG=False
FLASK_PORT=5001
