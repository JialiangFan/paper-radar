[Unit]
Description=Daily News Email Timer (12:30 AM EST/EDT)
Requires=daily-news-email.service

[Timer]
# Run daily at 12:30 AM Eastern Time (America/New_York)
# This automatically handles EST (UTC-5) and EDT (UTC-4) transitions
OnCalendar=*-*-* 00:30:00 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
