[Unit]
Description=Daily News Email Service
After=network.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/research_agent/daily_news_email
Environment="PATH=/usr/bin:/usr/local/bin:/home/ubuntu/miniconda3/bin"
# Load environment variables from .env file if it exists
EnvironmentFile=-/home/ubuntu/research_agent/daily_news_email/.env
# NewsAPI credentials (set these in .env or systemd override)
Environment="NEWS_API_KEY="
# Email configuration can be set via environment variables or config.yaml
ExecStart=/home/ubuntu/miniconda3/bin/python3 -m daily_news_email run --config /home/ubuntu/research_agent/daily_news_email/config.yaml
StandardOutput=journal
StandardError=journal
SyslogIdentifier=daily-news-email

[Install]
WantedBy=multi-user.target
