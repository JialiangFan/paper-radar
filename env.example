# 环境 / 数据库配置
APP_ENV=development
# DATABASE_PATH=/absolute/path/to/custom_papers.db

# OpenAI API 配置
OPENAI_API_KEY=your_openai_api_key_here

# 邮件配置
EMAIL_SENDER=sender@yourdomain.com
EMAIL_PASSWORD=your_smtp_password_here
EMAIL_RECEIVER=recipient@example.com
EMAIL_SENDER_NAME=Research Agent

# Mailgun API 配置（推荐）
USE_MAILGUN_API=true
MAILGUN_API_KEY=your_mailgun_api_key_here
MAILGUN_DOMAIN=mg.yourdomain.com

# 管理后台密码
ADMIN_PASSWORD=your_admin_password_here

# SMTP服务器配置（如果使用SMTP而不是Mailgun API）
SMTP_SERVER=localhost
SMTP_PORT=25
SMTP_USE_SSL=false
SMTP_USE_TLS=true
